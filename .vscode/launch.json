{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run i18n-doctor Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/packages/vscode/examples/demo-project"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "build-vscode-extension"
    }
  ]
}
