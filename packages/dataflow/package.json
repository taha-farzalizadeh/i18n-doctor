{
  "name": "@i18n-doctor/dataflow",
  "version": "0.9.1",
  "description": "Dynamic key analysis and basic data-flow for translation keys",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
