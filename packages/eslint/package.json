{
  "name": "@i18n-doctor/eslint-plugin",
  "version": "0.9.3",
  "description": "ESLint plugin for i18n-doctor — reuse the existing analyzer for live lint diagnostics",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@i18n-doctor/cli": "0.9.3",
    "@i18n-doctor/config": "0.9.3",
    "@i18n-doctor/coverage": "0.9.3",
    "@i18n-doctor/issues": "0.9.3",
    "@eslint/json": "^0.13.2"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@eslint/json": "^0.13.2",
    "@types/node": "^22.13.10",
    "eslint": "^9.28.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taha-farzalizadeh/i18n-doctor.git",
    "directory": "packages/eslint"
  },
  "homepage": "https://github.com/taha-farzalizadeh/i18n-doctor#readme",
  "bugs": {
    "url": "https://github.com/taha-farzalizadeh/i18n-doctor/issues"
  },
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "i18n",
    "i18n-doctor",
    "localization",
    "translation",
    "static-analysis",
    "unused-keys",
    "missing-keys"
  ]
}
