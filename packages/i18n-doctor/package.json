{
  "name": "i18n-doctor",
  "version": "0.10.2",
  "description": "Find unused, missing, and duplicate i18n translation keys in your JavaScript and TypeScript project",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "bin": {
    "i18n-doctor": "./bin.js"
  },
  "files": [
    "bin.js",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "dependencies": {
    "@i18n-doctor/cli": "0.10.2",
    "@i18n-doctor/config": "0.10.2"
  },
  "keywords": [
    "i18n",
    "i18n-doctor",
    "i18n-unused",
    "i18n-unused-keys",
    "i18n-checker",
    "i18n-lens",
    "i18n-analyzer",
    "internationalization",
    "localization",
    "translation",
    "static-analysis",
    "unused-keys",
    "missing-keys",
    "duplicate-keys",
    "i18next",
    "react-i18next",
    "react-intl",
    "vue-i18n",
    "next-intl",
    "lingui",
    "cli",
    "lint",
    "check"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taha-farzalizadeh/i18n-doctor.git",
    "directory": "packages/i18n-doctor"
  },
  "homepage": "https://github.com/taha-farzalizadeh/i18n-doctor#readme",
  "bugs": {
    "url": "https://github.com/taha-farzalizadeh/i18n-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
