{
  "name": "@i18n-doctor/config",
  "version": "0.10.0",
  "description": "Configuration loading, ignore rules, and inline suppression for i18n-doctor",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@i18n-doctor/ast": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taha-farzalizadeh/i18n-doctor.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/taha-farzalizadeh/i18n-doctor#readme",
  "bugs": {
    "url": "https://github.com/taha-farzalizadeh/i18n-doctor/issues"
  },
  "license": "MIT",
  "keywords": [
    "i18n",
    "i18n-doctor",
    "localization",
    "translation",
    "static-analysis",
    "unused-keys",
    "missing-keys",
    "config",
    "configuration",
    "ignore",
    "suppression"
  ]
}
