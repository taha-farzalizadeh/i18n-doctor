{
  "name": "@i18n-doctor/cli",
  "version": "0.10.0",
  "description": "Production CLI for i18n-doctor static localization analysis",
  "type": "module",
  "bin": {
    "i18n-doctor": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@i18n-doctor/config": "0.10.0",
    "@i18n-doctor/context": "0.10.0",
    "@i18n-doctor/coverage": "0.10.0",
    "@i18n-doctor/detect": "0.10.0",
    "@i18n-doctor/issues": "0.10.0",
    "@i18n-doctor/scanner": "0.10.0",
    "@i18n-doctor/sources": "0.10.0",
    "@i18n-doctor/usages": "0.10.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taha-farzalizadeh/i18n-doctor.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/taha-farzalizadeh/i18n-doctor#readme",
  "bugs": {
    "url": "https://github.com/taha-farzalizadeh/i18n-doctor/issues"
  },
  "license": "MIT",
  "keywords": [
    "i18n",
    "i18n-doctor",
    "localization",
    "translation",
    "static-analysis",
    "unused-keys",
    "missing-keys",
    "cli",
    "command-line",
    "npx",
    "check",
    "lint"
  ]
}
