{
  "name": "i18n-doctor-jetbrains",
  "version": "0.9.5",
  "private": true,
  "description": "JetBrains / WebStorm plugin — thin LSP client for the i18n-doctor language server",
  "license": "MIT",
  "scripts": {
    "bundle:server": "node scripts/bundle-server.mjs",
    "prebuild": "npm run build -w @i18n-doctor/language-server --if-present && npm run bundle:server",
    "build": "./gradlew buildPlugin -x test -x buildSearchableOptions",
    "test:unit": "./gradlew test",
    "test:e2e": "npm run bundle:server && node scripts/e2e-lsp.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "package": "npm run prebuild && ./gradlew buildPlugin -x buildSearchableOptions",
    "publish": "npm run package && ./gradlew publishPlugin",
    "runIde": "npm run prebuild && ./gradlew runIde",
    "verify": "./gradlew verifyPlugin"
  },
  "dependencies": {
    "@i18n-doctor/language-server": "0.9.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vscode-jsonrpc": "^8.2.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taha-farzalizadeh/i18n-doctor.git",
    "directory": "packages/jetbrains"
  }
}
